<div class="form-grid" data-role-fields>
  <div class="field">
    <%= form.label :role %>
    <%= form.select :role, User::ROLE_LABELS.map { |value, label| [label, value] }, {}, **field_error_attributes(user, :role) %>
    <%= field_error(user, :role) %>
  </div>
  <div class="field">
    <%= form.label :subteam_id, "Class · Subteam" %>
    <%= form.select :subteam_id, subteam_options(user.subteam_id), { include_blank: "No membership (Chief Engineer only)" }, **field_error_attributes(user, :subteam) %>
    <p class="hint">Members and officers belong to exactly one subteam. Chief Engineers have no membership.</p>
    <%= field_error(user, :subteam) %>
  </div>
</div>
