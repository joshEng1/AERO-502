<% content_for :title, "#{@task.title} · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow"><%= @task.project.full_name %></p>
    <h1><%= @task.title %></h1>
    <span class="badge status-<%= @task.status %>"><%= @task.status.to_s.humanize %></span>
  </div>
  <% if current_user.can_manage?(@task) %>
    <%= link_to "Edit task", edit_task_path(@task), class: "button" %>
  <% end %>
</div>

<% visible_entries = current_user.leader? ? @task.time_entries : @task.time_entries.where(user: current_user) %>
<% visible_actual = visible_entries.sum(:hours) %>
<div class="detail-grid">
  <section class="panel">
    <h2>Task details</h2>
    <dl class="detail-list">
      <div><dt>Subteams of active assignees</dt><dd><%= @task.subteam_names %></dd></div>
      <div><dt>Expected deliverables</dt><dd><%= simple_format(@task.description) %></dd></div>
      <div><dt>Work instructions</dt><dd><%= simple_format(@task.instructions_without_reference_links.presence || "No additional instructions.") %></dd></div>
      <div><dt>Assigned members</dt><dd><%= @task.assignees.map(&:name).to_sentence.presence || "Unassigned" %></dd></div>
      <div><dt>Primary contact</dt><dd><%= @task.primary_contact&.name || "None selected" %></dd></div>
      <div data-estimate><dt>Estimated hours</dt><dd><%= estimate_label(@task.estimated_hours) %></dd></div>
      <div><dt>Start date</dt><dd><%= @task.start_date.to_fs(:long) %></dd></div>
      <div><dt>Due date</dt><dd><%= @task.due_date.to_fs(:long) %></dd></div>
      <div>
        <dt>Reference links</dt>
        <dd>
          <% if @task.reference_urls.any? %>
            <ul class="link-list">
              <% @task.reference_urls.each do |url| %>
                <li><%= external_link(url) %></li>
              <% end %>
            </ul>
          <% else %>
            None
          <% end %>
        </dd>
      </div>
    </dl>
  </section>

  <aside>
    <section class="panel effort-panel">
      <h2>Planned vs. actual</h2>
      <% unless current_user.leader? %><p class="hint">Actual hours show your own entries. The estimate is for the whole task.</p><% end %>
      <div class="effort-numbers">
        <div><strong><%= number_with_precision(@task.estimated_hours, precision: 2, strip_insignificant_zeros: true) %>h</strong><span>Estimated</span></div>
        <div><strong><%= number_with_precision(visible_actual, precision: 2, strip_insignificant_zeros: true) %>h</strong><span>Actual</span></div>
        <div><strong><%= number_with_precision((visible_actual - @task.estimated_hours), precision: 2, strip_insignificant_zeros: true) %>h</strong><span>Variance</span></div>
      </div>
      <p class="variance-note" data-variance><%= variance_label((visible_actual - @task.estimated_hours)) %></p>
    </section>

    <% if current_user.can_work_on?(@task) %>
      <section class="panel">
        <h2>Update status</h2>
        <%= form_with model: @task, class: "inline-form" do |form| %>
          <%= form.label :status, "Task status" %>
          <%= form.select :status, Task.statuses.keys.map { |status| [status.humanize, status] } %>
          <%= form.submit "Save status", class: "button" %>
        <% end %>
      </section>

      <section class="panel">
        <h2>Record actual hours</h2>
        <%= form_with model: [@task, @time_entry], class: "inline-form" do |form| %>
          <%= form.label :hours %>
          <%= form.number_field :hours, min: 0.01, max: TimeEntry::MAX_HOURS_PER_DAY, step: 0.01, required: true %>
          <%= form.label :worked_on, "Date worked" %>
          <%= form.date_field :worked_on, required: true %>
          <%= form.label :note, "Note (optional)" %>
          <%= form.text_field :note %>
          <%= form.submit "Add hours", class: "button" %>
        <% end %>
      </section>
    <% end %>
  </aside>
</div>

<% if @task.blocked? %><p class="panel" data-blocked>Blocked by unfinished prerequisite work.</p><% end %>
<% if current_user.can_manage?(@task) %>
  <section class="panel" data-prerequisites>
    <h2>Prerequisites</h2>
    <% if @task.prerequisites.any? %>
      <ul><% @task.prerequisites.includes(:assignees).order(:title).each do |prerequisite| %>
        <li><%= link_to prerequisite.title, prerequisite %> · <%= prerequisite.status.humanize %> · <%= prerequisite.assignees.map(&:name).to_sentence.presence || "Unassigned" %></li>
      <% end %></ul>
    <% else %><p>No prerequisites.</p><% end %>
  </section>
  <section class="panel" data-history>
    <h2>History</h2>
    <% events = @task.history %>
    <% if events.any? %>
      <ol class="plain-list history-list">
        <% events.each do |event| %>
          <li>
            <time datetime="<%= event.created_at.iso8601 %>"><%= event.created_at.to_fs(:long) %></time>
            <span><strong><%= event.actor.name %></strong> <%= event.description %></span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="muted">No changes have been recorded yet.</p>
    <% end %>
  </section>
<% end %>

<section class="panel">
  <h2>Hours by member</h2>
  <% if visible_entries.any? %>
    <div class="member-grid">
      <% (current_user.leader? ? (@task.assignees.to_a + visible_entries.includes(:user).map(&:user)).uniq : [current_user]).each do |member| %>
        <article>
          <span><%= member.name %></span>
          <strong><%= number_with_precision(@task.actual_hours_for(member), precision: 2, strip_insignificant_zeros: true) %> hours</strong>
        </article>
      <% end %>
    </div>

    <h3 class="subsection-heading">Time entries</h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Date worked</th>
            <th scope="col">Member</th>
            <th scope="col">Hours</th>
            <th scope="col">Note</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% visible_entries.includes(:user).order(worked_on: :desc, id: :desc).each do |entry| %>
            <tr data-time-entry>
              <td><%= entry.worked_on.to_fs(:long) %></td>
              <td><%= entry.user.name %></td>
              <td><%= estimate_label(entry.hours) %></td>
              <td><%= entry.note %></td>
              <td>
                <% if entry.user_id == current_user.id %>
                  <div class="row-actions">
                    <%= link_to "Edit", edit_time_entry_path(entry) %>
                    <%= button_to "Delete", time_entry_path(entry), method: :delete, class: "link-button" %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="muted">No actual hours have been recorded.</p>
  <% end %>
</section>
